# Zynq BootROM reads BOOT.BIN from FAT; Linux rootfs is SD partition 2.
part /boot --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --active --align 4 --fixed-size=512M
part / --source rootfs --exclude-path=boot/ --ondisk mmcblk --fstype=ext4 --label root --align 4
bootloader --ptable msdos
