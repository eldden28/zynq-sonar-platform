#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
DAEMON=/usr/sbin/cora-conventional-dashboard
PIDFILE=/var/run/cora-conventional-dashboard.pid
DASHBOARD_ARGS="--bind 0.0.0.0 --port 8084"

[ -r /etc/default/cora-conventional-dashboard ] && \
    . /etc/default/cora-conventional-dashboard

case "$1" in
    start)
        echo "Starting Cora conventional acoustic modem dashboard"
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$PIDFILE" --exec "$DAEMON" -- $DASHBOARD_ARGS
        ;;
    stop)
        echo "Stopping Cora conventional acoustic modem dashboard"
        start-stop-daemon --stop --quiet --retry TERM/5/KILL/2 \
            --pidfile "$PIDFILE"
        rm -f "$PIDFILE"
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        if [ -s "$PIDFILE" ] && \
                kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "Cora conventional acoustic modem dashboard is running"
            exit 0
        fi
        echo "Cora conventional acoustic modem dashboard is stopped"
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
