options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'PC control and observation graph for Cora Remote I/O v1.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: cora_remote_io_pc
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Cora Remote I/O - PC
    window_size: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: board_ip
  id: variable
  parameters:
    comment: ''
    value: '"192.168.10.2"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 12]
    rotation: 0
    state: enabled
- name: adc_samp_rate
  id: variable
  parameters:
    comment: ''
    value: '1e3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 60]
    rotation: 0
    state: enabled
- name: pwm_samp_rate
  id: variable
  parameters:
    comment: ''
    value: '100e3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 108]
    rotation: 0
    state: enabled
- name: pwm_level
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: 'PWM level (-1 = 0%, 0 = 50%, +1 = 100%)'
    min_len: '300'
    orient: Qt.Horizontal
    rangeType: float
    start: '-1.0'
    step: '0.01'
    stop: '1.0'
    value: '0.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 12]
    rotation: 0
    state: enabled
- name: network_tcp_source_0
  id: network_tcp_source
  parameters:
    addr: board_ip
    affinity: ''
    alias: ''
    comment: 'A0 samples from Cora: normalized float32 at adc_samp_rate.'
    maxoutbuf: '0'
    minoutbuf: '0'
    port: '50000'
    server: 'False'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [72, 280]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    axislabels: 'True'
    comment: 'A0 normalized voltage: -1 = 0 V, +1 = 3.3 V.'
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: A0_normalized
    legend: 'True'
    name: '"Cora A0 (XADC)"'
    nconnections: '1'
    srate: adc_samp_rate
    stemplot: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    ylabel: Normalized_A0
    yunit: '""'
    ymax: '1.0'
    ymin: '-1.0'
    size: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 260]
    rotation: 0
    state: enabled
- name: analog_const_source_x_0
  id: analog_const_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: 'Continuously produces the slider value for board PWM.'
    const: pwm_level
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [72, 472]
    rotation: 0
    state: enabled
- name: blocks_throttle_0
  id: blocks_throttle
  parameters:
    affinity: ''
    alias: ''
    comment: 'Match Cora Remote I/O PWM stream rate.'
    ignoretag: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: pwm_samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 472]
    rotation: 0
    state: enabled
- name: cora_tcp_float_sink_0
  id: cora_tcp_float_sink
  parameters:
    affinity: ''
    alias: ''
    comment: 'PWM command stream to the Cora board.'
    host: board_ip
    maxoutbuf: '0'
    minoutbuf: '0'
    port: '50001'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 472]
    rotation: 0
    state: enabled

connections:
- [network_tcp_source_0, '0', qtgui_time_sink_x_0, '0']
- [analog_const_source_x_0, '0', blocks_throttle_0, '0']
- [blocks_throttle_0, '0', cora_tcp_float_sink_0, '0']

metadata:
  file_format: 1
