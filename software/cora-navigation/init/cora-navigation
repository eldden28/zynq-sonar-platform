#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
DAEMON=/usr/sbin/cora-navigation
PIDFILE=/var/run/cora-navigation.pid
NAVIGATION_ARGS="--bind 0.0.0.0 --dvl-port 8083 --acoustic-port 8084"

[ -r /etc/default/cora-navigation ] && . /etc/default/cora-navigation

case "$1" in
    start)
        echo "Starting Cora navigation laboratory"
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$PIDFILE" --exec "$DAEMON" -- $NAVIGATION_ARGS
        ;;
    stop)
        echo "Stopping Cora navigation laboratory"
        start-stop-daemon --stop --quiet --retry TERM/5/KILL/2 \
            --pidfile "$PIDFILE"
        rm -f "$PIDFILE"
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        if [ -s "$PIDFILE" ] &&
                kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "Cora navigation laboratory is running"
            exit 0
        fi
        echo "Cora navigation laboratory is stopped"
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
